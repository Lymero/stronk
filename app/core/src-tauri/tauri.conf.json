{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stronk",
  "version": "0.1.0",
  "identifier": "app.stronk.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "pnpm --filter @stronk/ui dev",
    "beforeBuildCommand": "pnpm --filter @stronk/ui build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Stronk", "width": 1200, "height": 900, "minWidth": 420 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stronk.gg/schemas/build.v1.schema.json",
  "title": "Build",
  "description": "Build statistics for one champion and role, published at /{patch}/{region}/{elo}/{champion}/{role}.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "patch", "region", "elo", "champion", "role", "games", "runes", "items", "spells"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1], "description": "Contract major version. A breaking change publishes a new version alongside this one." },
    "patch": { "$ref": "#/$defs/Patch" },
    "region": { "type": "string", "pattern": "^[a-z0-9]{2,8}$", "description": "Riot platform or region id, lower case (for example \"euw1\")." },
    "elo": { "type": "string", "pattern": "^[a-z_]{2,32}$", "description": "Elo bracket id (for example \"diamond_plus\")." },
    "champion": { "type": "string", "pattern": "^[A-Za-z0-9]{1,32}$", "description": "Data Dragon champion key (for example \"Viego\")." },
    "role": { "$ref": "#/$defs/Role" },
    "games": { "type": "integer", "minimum": 0, "description": "Games behind this file." },
    "runes": { "type": "array", "items": { "$ref": "#/$defs/RuneOption" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/ItemOption" } },
    "spells": { "type": "array", "items": { "$ref": "#/$defs/SpellOption" } },
    "starts": {
      "type": "array",
      "items": { "$ref": "#/$defs/StartOption" },
      "description": "The starting items (ADR-071): what players buy before leaving base, without potions and wards, each start estimated among the others."
    },
    "lateSlot": { "type": "integer", "minimum": 1, "maximum": 6, "description": "The item slot of the late items: the item completed at this slot and every later one, as one decision (ADR-067). Absent: every slot is its own." },
    "skillOrder": { "type": "array", "items": { "$ref": "#/$defs/SkillOrderOption" } },
    "runeChoices": {
      "type": "array",
      "items": { "$ref": "#/$defs/RuneChoice" },
      "description": "Each rune row on its own, for information: every primary row, the secondary pair and every stat shard row (ADR-057). Imports still write a whole page from `runes`."
    }
  },
  "$defs": {
    "Patch": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$", "description": "Game patch, major.minor (for example \"26.20\")." },
    "Role": { "type": "string", "enum": ["TOP", "JUNGLE", "MIDDLE", "BOTTOM", "UTILITY"] },
    "Flag": {
      "type": "string",
      "enum": ["low_sample", "low_overlap", "no_clear_difference", "fragile"],
      "description": "Why an estimate should not be trusted at face value. See docs/wpa-method.md, section 7."
    },
    "Interval": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "95% interval [low, high] of the WPA estimate."
    },
    "RunePage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryStyle", "subStyle", "perks"],
      "properties": {
        "primaryStyle": { "type": "integer", "minimum": 0 },
        "subStyle": { "type": "integer", "minimum": 0 },
        "perks": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 9, "maxItems": 9, "description": "Four primary, two secondary, three shards." }
      }
    },
    "Comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versus", "wpa", "q"],
      "description": "The option head to head with the most played option at its decision point (docs/wpa-method.md, section 5; ADR-036).",
      "properties": {
        "versus": { "type": "integer", "minimum": 0, "description": "The most played option compared with: keystone id for runes, item id for items." },
        "wpa": { "type": "number", "description": "Win probability added by this option against `versus`." },
        "q": { "type": "number", "minimum": 0, "maximum": 1, "description": "False-discovery-adjusted p-value of no difference, across the patch." },
        "ci": { "$ref": "#/$defs/Interval", "description": "95% interval of `wpa`." }
      }
    },
    "RuneOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "wpa", "ci", "n", "flags"],
      "properties": {
        "page": { "$ref": "#/$defs/RunePage" },
        "wpa": { "type": ["number", "null"], "description": "Win probability added; null when flagged low_overlap." },
        "ci": { "oneOf": [{ "$ref": "#/$defs/Interval" }, { "type": "null" }] },
        "n": { "type": "integer", "minimum": 0, "description": "Decisions behind the estimate." },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/Flag" }, "uniqueItems": true },
        "games": { "type": "integer", "minimum": 0, "description": "Games played with exactly this full page." },
        "comparison": { "$ref": "#/$defs/Comparison" }
      }
    },
    "RuneChoiceComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versus", "wpa", "q"],
      "description": "The choice head to head with its row's most played choice (ADR-036).",
      "properties": {
        "versus": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "maxItems": 2, "description": "The row's most played choice: one rune or shard, or the secondary pair." },
        "wpa": { "type": "number", "description": "Win probability added by this choice against `versus`." },
        "q": { "type": "number", "minimum": 0, "maximum": 1, "description": "False-discovery-adjusted p-value of no difference, across the patch." },
        "ci": { "$ref": "#/$defs/Interval", "description": "95% interval of `wpa`." }
      }
    },
    "StartComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versus", "wpa", "q"],
      "description": "The start head to head with the most played start (ADR-036).",
      "properties": {
        "versus": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "description": "The most played start's items." },
        "wpa": { "type": "number", "description": "Win probability added by this start against `versus`." },
        "q": { "type": "number", "minimum": 0, "maximum": 1, "description": "False-discovery-adjusted p-value of no difference, across the patch." },
        "ci": { "$ref": "#/$defs/Interval", "description": "95% interval of `wpa`." }
      }
    },
    "StartOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "buy", "games", "wpa", "ci", "n", "flags"],
      "description": "One start: the items bought before leaving base, without supplies (potions, wards).",
      "properties": {
        "items": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "description": "Data Dragon item ids, smallest first, each once." },
        "buy": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "description": "What is most often bought with this start, supplies included and repeated as bought: what an import lists." },
        "games": { "type": "integer", "minimum": 0, "description": "Games with this start." },
        "wpa": { "type": ["number", "null"], "description": "Win probability added against the other starts; null when not estimated." },
        "ci": { "oneOf": [{ "$ref": "#/$defs/Interval" }, { "type": "null" }] },
        "n": { "type": "integer", "minimum": 0, "description": "Decisions behind the estimate." },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/Flag" }, "uniqueItems": true },
        "comparison": { "$ref": "#/$defs/StartComparison" }
      }
    },
    "RuneChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "perks", "wpa", "ci", "n", "flags"],
      "description": "One choice of one rune row, estimated among the choices of that row.",
      "properties": {
        "kind": { "type": "string", "enum": ["primary", "secondary", "shard"], "description": "A primary tree's row, the secondary tree's two runes, or a stat shard row." },
        "style": { "type": "integer", "minimum": 0, "description": "The tree, for primary rows and secondary pairs." },
        "row": { "type": "integer", "minimum": 1, "maximum": 3, "description": "The row, for primary rows (after the keystone) and shard rows." },
        "perks": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "maxItems": 2, "description": "The rune or shard chosen, or the secondary pair, smallest id first." },
        "games": { "type": "integer", "minimum": 0, "description": "Games with this choice." },
        "wpa": { "type": ["number", "null"], "description": "Win probability added against the row's other choices; null when not estimated." },
        "ci": { "oneOf": [{ "$ref": "#/$defs/Interval" }, { "type": "null" }] },
        "n": { "type": "integer", "minimum": 0, "description": "Decisions behind the estimate." },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/Flag" }, "uniqueItems": true },
        "comparison": { "$ref": "#/$defs/RuneChoiceComparison" }
      }
    },
    "ItemOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "item", "wpa", "ci", "n", "flags"],
      "properties": {
        "slot": { "type": "integer", "minimum": 1, "maximum": 6 },
        "item": { "type": "integer", "minimum": 1, "description": "Data Dragon item id." },
        "wpa": { "type": ["number", "null"] },
        "ci": { "oneOf": [{ "$ref": "#/$defs/Interval" }, { "type": "null" }] },
        "n": { "type": "integer", "minimum": 0 },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/Flag" }, "uniqueItems": true },
        "picks": { "type": "integer", "minimum": 0, "description": "Times this item was chosen at this slot." },
        "comparison": { "$ref": "#/$defs/Comparison" }
      }
    },
    "SpellOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spells", "wpa", "ci", "n", "flags"],
      "properties": {
        "spells": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2, "description": "Summoner spell ids, D then F." },
        "wpa": { "type": ["number", "null"] },
        "ci": { "oneOf": [{ "$ref": "#/$defs/Interval" }, { "type": "null" }] },
        "n": { "type": "integer", "minimum": 0 },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/Flag" }, "uniqueItems": true },
        "games": { "type": "integer", "minimum": 0, "description": "Games played with this pair, whichever key each spell was on." }
      }
    },
    "SkillOrderOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "n"],
      "properties": {
        "order": { "type": "array", "items": { "type": "string", "enum": ["Q", "W", "E", "R"] }, "maxItems": 18 },
        "n": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
